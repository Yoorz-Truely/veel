// sequences/main.veel: veel-handle, handles that name nothing, the wrong kind, or are defined twice
source @interview "Interview again" media="media/interview.mov" rate=25 len=60s

sequence @main "Main" rate=25 size=[1920 1080] {
  track @v1 video {
    clip @a from=@intervew 0..+2s at 0
    clip @b from=@main 0..+2s at 50
    clip @c from=interview 0..+2s at 100
    clip @a from=@interview 0..+2s at 150 {
      effect @push qtblend
      effect @push qtblend
    }
  }
}
