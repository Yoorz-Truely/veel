// veel-missing: a required handle, value or attribute left out, and a block of keys with none
source @shot "Shot" media="media/shot.mov" rate=25

source @take "Take" media="media/take.mov" rate=25 len=60s

sequence @main "Main" rate=25 size=[1920 1080] {
  track @v1 video {
    clip @a from=@take 0..+2s {
      effect qtblend
    }
    clip @b from=@take at 100
    clip @c from=@take 0..+2s at 200 {
      effect @push qtblend {
        rect
        rotation {
        }
      }
      crossfade
    }
  }
  track @v2
}
