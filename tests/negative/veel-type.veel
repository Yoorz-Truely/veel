// veel-type: values of the wrong type or shape
source @shot "Shot" media=media/shot.mov rate=25 len=60s hash=sha256:0123

sequence @main "Main" rate="25" size=[1920] {
  track @v1 video {
    clip @a from=@shot 0..+2s at 0 {
      effect @push qtblend {
        compositing {
          key 0 screen
        }
        rotation 2 3
        rect 1920
      }
      crossfade 12 13
    }
  }
}
