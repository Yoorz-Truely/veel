// veel-crossfade-next: crossfades with no clip starting where their clip ends
source @shot "Shot" media="media/shot.mov" rate=25 len=60s

sequence @main "Main" rate=25 size=[1920 1080] {
  track @v1 video {
    clip @a from=@shot 4s..+2s at 0 {
      crossfade 12
    }
    clip @b from=@shot 10s..+2s at 60 {
      crossfade 12
    }
  }
}
