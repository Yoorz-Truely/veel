// veel-kind: a kind the slice does not know, and known kinds where they cannot stand
source @shot "Shot" media="media/shot.mov" rate=25 len=60s

sorce @typo "Typo" media="media/typo.mov" rate=25 len=60s

sequence @main "Main" rate=25 size=[1920 1080] {
  trak @v2 video
  track @v1 video {
    clip @a from=@shot 0..+2s at 0 {
      effect @push qtblend {
        rect {
          kye 0 [0 0 1920 1080]
        }
      }
    }
  }
  clip @b from=@shot 0..+2s at 50
}

clip @c from=@shot 0..+1s at 0
