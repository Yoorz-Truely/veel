// veel-crossfade-overlap: mixes at a clip's two ends that overlap, and mixes longer than their clip
source @shot "Shot" media="media/shot.mov" rate=25 len=60s

sequence @main "Main" rate=25 size=[1920 1080] {
  track @v1 video {
    clip @a from=@shot 10s..+2s at 0 {
      crossfade 20
    }
    clip @b from=@shot 20s..+15 at 50 {
      crossfade 20
    }
    clip @c from=@shot 30s..+2s at 65
  }
  track @v2 video {
    clip @short from=@shot 10s..+5 at 0 {
      crossfade 20
    }
    clip @long from=@shot 20s..+2s at 5
  }
  track @v3 video {
    clip @first from=@shot 10s..+2s at 0 {
      crossfade 1s
    }
    clip @tiny from=@shot 20s..+4 at 50
  }
}
