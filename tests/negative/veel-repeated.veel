// veel-repeated: an attribute or line given twice, and a parameter given a value and keys
source @shot "Shot" media="media/shot.mov" rate=25 len=60s {
  rate 25
}

sequence @main "Main" rate=25 size=[1920 1080] {
  timecode non-drop
  timecode non-drop start=01:00:00:00
  track @v1 video {
    clip @a from=@shot 0..+2s at 0 {
      effect @push qtblend {
        rect [0 0 1920 1080] {
          key 0 [0 0 1920 1080]
        }
      }
      crossfade 4
      crossfade 6
    }
    clip @b from=@shot 4s..+2s at 50
  }
}
